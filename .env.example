# ---------------------------------------------------------------------------
# Communova client — environment template
# Copy to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# Better Auth ---------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-32-byte-random-string
BETTER_AUTH_URL=http://localhost:3000

# MongoDB Atlas (shared with the API) ---------------------------------------
# Placeholder shape: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/communova
MONGODB_DB=communova

# Google OAuth --------------------------------------------------------------
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# Express API ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# Development only ----------------------------------------------------------
# Set to 1 to use Better Auth's in-memory adapter (no mongod required).
# Accounts reset on restart. Leave unset for MongoDB.
# AUTH_DEV_MEMORY=1
